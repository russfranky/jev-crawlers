# .crawlersignore — paths the crawlers never read.
# Copy this to the root of any repo you crawl, or keep the defaults.
# Patterns use gitignore-style globs (* never crosses /).

node_modules/
.git/
dist/
build/
vendor/
*.min.js
*-min.js
package-lock.json
yarn.lock
*.map
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.woff
*.woff2
*.ttf
*.env
